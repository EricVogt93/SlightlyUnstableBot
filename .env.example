# Discord Bot Configuration
# Copy this file to .env and fill in your values

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_token_here

# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=subot
DB_USER=root
DB_PASSWORD=your_password_here

# Tax system settings
# Amount each player owes per week (can be flasks, gold, materials, etc.)
TAX_PER_WEEK=18
# Name of the tax item (shown in messages)
TAX_NAME=flasks

# Optional: WoW Audit API token
WOWAUDIT_TOKEN=your_wowaudit_token_here
